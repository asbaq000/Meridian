# --- Database -------------------------------------------------------------
# Neon / Supabase / any Postgres 14+ connection string.
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Separate database used by `npm test`. Tests TRUNCATE tables, so never point
# this at the same database as DATABASE_URL.
TEST_DATABASE_URL=

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Email ----------------------------------------------------------------
# Leave RESEND_API_KEY empty to use the console transport (logs formatted
# emails to stdout). Set it to switch to real delivery with zero code changes.
RESEND_API_KEY=
EMAIL_FROM="Smart Booking <onboarding@resend.dev>"

# --- Reminders ------------------------------------------------------------
# Run the 24h reminder sweep inside the API process.
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=300000
REMINDER_LEAD_HOURS=24
